# Optional public build-time configuration. Never put secrets in NEXT_PUBLIC_* values.
# Root development needs no variables. GitHub Actions supplies the deployment prefix.
# NEXT_PUBLIC_SITE_URL=https://opendqm.org
# GITHUB_PAGES=true
# NEXT_PUBLIC_BASE_PATH=/OpenDQM-copy

# Choose ONE intake mode; priority: Apps Script > email > Worker.
# See integration/README.md. Restart dev / rebuild after changing a value.
# NEXT_PUBLIC_INTERVIEW_APPS_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# NEXT_PUBLIC_INTERVIEW_EMAIL_ENDPOINT=https://formspree.io/f/FORM_ID
# NEXT_PUBLIC_INTERVIEW_ENDPOINT=https://YOUR-WORKER.workers.dev
