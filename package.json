{
  "name": "opendqm-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenDQM website built with Next.js, React, and TypeScript.",
  "scripts": {
    "dev": "next dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "next build"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.7",
    "next": "^16.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
